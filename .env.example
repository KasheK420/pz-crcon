# ============================================================
# pz-crcon — environment template
# Copy to .env and fill secrets. NEVER commit .env.
# ============================================================

# ── App ──────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_32_BYTES_RANDOM_PADDED
LOG_LEVEL=info
WS_HEARTBEAT_SEC=30

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://pzcrcon_user:dev_password@localhost:5432/pzcrcon

# ── Discord OAuth (no bot required) ──────────────────────
# Discord is used for identity only. Authorization is an allowlist:
# DISCORD_ADMIN_IDS is a comma-separated list of Discord user IDs.
# The first ID becomes OWNER on first login; the rest become ADMIN.
# Anyone not in the list is rejected.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_ADMIN_IDS=

# ── PZ RCON ──────────────────────────────────────────────
RCON_HOST=85.215.222.81
RCON_PORT=27015
RCON_PASSWORD=CHANGE_ME

# ── PZ config file prefix ────────────────────────────────
# Name of the PZ config set on disk: `<prefix>.ini`,
# `<prefix>_SandboxVars.lua`, `<prefix>_spawnpoints.lua`, etc.
# Normally auto-detected from the pz-server container's SERVERNAME
# env via the Docker socket proxy. Set explicitly here when the
# container is unreachable (local dev) or SERVERNAME is unset.
# Default fallback is `servertest`.
# PZ_SERVER_PREFIX=MajorlukPZ

# ── Lua mod webhook (Phase 4) ────────────────────────────
WEBHOOK_HMAC_SECRET=CHANGE_ME_GENERATE_32_BYTES_RANDOM_PADDED

# ── Backups ──────────────────────────────────────────────
BACKUP_PATH=/var/lib/pz-crcon/backups
BACKUP_RETENTION_DAYS=14
