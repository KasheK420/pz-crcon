# ============================================================
# pz-crcon — environment variables (template)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ── PZ Dedicated Server (RCON) ───────────────────────────
PZ_RCON_HOST=127.0.0.1
PZ_RCON_PORT=27015
PZ_RCON_PASSWORD=

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://pzcrcon:CHANGE_ME@localhost:5432/pzcrcon

# ── App ──────────────────────────────────────────────────
APP_URL=http://localhost:3000
APP_SECRET=CHANGE_ME_RANDOM_32_BYTES
NODE_ENV=development

# ── Discord OAuth (admin auth) ───────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=
DISCORD_BOT_TOKEN=

# ── Public Live Map ──────────────────────────────────────
PUBLIC_SERVER_NAME=
PUBLIC_SERVER_DESCRIPTION=
PUBLIC_DISCORD_INVITE=

# ── PZ Mod Webhook (optional, for live data) ─────────────
MOD_WEBHOOK_TOKEN=CHANGE_ME_RANDOM_TOKEN

# ── Backups ──────────────────────────────────────────────
BACKUP_PATH=/var/lib/pz-crcon/backups
BACKUP_RETENTION_DAYS=14
