{
  "name": "pz-crcon",
  "version": "0.1.0-alpha",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env server/ws.ts",
    "build": "next build",
    "start": "tsx server/ws.ts",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:seed": "tsx lib/db/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@prisma/client": "7.8.0",
    "async-mutex": "^0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockerode": "^4.0.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "next": "15.1.4",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "rcon-client": "^4.2.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.0.0",
    "@types/dockerode": "^4.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/ws": "^8.18.1",
    "eslint": "9.18.0",
    "eslint-config-next": "15.1.4",
    "pino-pretty": "^13.1.3",
    "postcss": "8.5.1",
    "prettier": "3.4.2",
    "prisma": "5.22.0",
    "tailwindcss": "4.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "overrides": {
      "@tailwindcss/node": "4.0.0",
      "@tailwindcss/oxide": "4.0.0"
    }
  }
}
